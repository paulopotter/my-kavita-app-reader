<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
            android:launchMode="singleTask"
            android:theme="@style/Theme.App.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
            Custom scheme — always registered, static, committed. Works with the app fully
            closed (e.g. a tapped system notification's PendingIntent). React Navigation's
            `linking` prop (App.tsx) resolves the URI into a screen once the app process is up.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="mymangareader" />
            </intent-filter>

            <!--
            GENERATED_DEEP_LINK_HOSTS_START
            Block generated by the `generateDeepLinkHosts` Gradle task (see
            app/build.gradle.kts) from `deeplink.hostN` entries in local.properties
            (a file outside version control — a user's own host never lands here in a
            committed state). Do not edit manually between the markers: the task
            overwrites this region on every build whenever the computed content differs
            from what is already here; when there is no change, the file is left
            untouched. `clearDeepLinkHosts` restores it to empty after producing an APK.
            -->
        <!-- GENERATED_DEEP_LINK_HOSTS_END -->
        </activity>

    </application>

</manifest>
