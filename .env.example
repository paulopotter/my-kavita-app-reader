# ============================================================
# mymangareader — variáveis de ambiente
# Copie para .env e preencha com seus valores.
# Nunca commite o .env.
# ============================================================

# URL do servidor Kavita (sem barra no final)
# Exemplo: http://192.168.1.100:5000
KAVITA_URL=

# API key do Kavita (gerada em Configurações > API Key no Kavita)
KAVITA_API_KEY=

# URL de atualização OTA do bundle JS
# Padrão: GitHub Releases do repo oficial (deixe vazio para usar o padrão)
OTA_UPDATE_URL=

# URL do servidor BFF (plugin opcional — deixe vazio para desativar)
BFF_URL=

# Provider de notificações: ntfy | firebase | none
NOTIFICATION_PROVIDER=none

# URL do servidor ntfy (obrigatório se NOTIFICATION_PROVIDER=ntfy)
NTFY_URL=
NTFY_TOPIC=
