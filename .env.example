# ============================================================
# mymangareader — variáveis de ambiente
# Copie para .env e preencha com seus valores.
# Nunca commite o .env.
# ============================================================

# Caminho para o Android SDK na sua máquina
# macOS via Android Studio: /Users/SEU_USUARIO/Library/Android/sdk
# macOS via brew/cmdline-tools: /usr/local/share/android-commandlinetools
ANDROID_SDK_DIR=

# URL do servidor Kavita (sem barra no final)
# Exemplo: http://192.168.1.100:5000
KAVITA_URL=

# API key do Kavita (gerada em Configurações > API Key no Kavita)
KAVITA_API_KEY=

# URL do manifest OTA (latest.json)
# Teste local: http://localhost:8080/latest.json
# Padrão: GitHub Releases do repo oficial (deixe vazio para usar o padrão)
OTA_MANIFEST_URL=

# Fallback para as releases oficiais quando o OTA_MANIFEST_URL acima não entrega atualização.
# Serve pro caso comum de desenvolvimento: o manifest local só existe enquanto `make ota-*` roda,
# então sem isso um device em build de dev nunca receberia uma release de verdade.
# Ambos assumem true quando vazios. O fallback só aceita uma release MAIS NOVA que a instalada,
# então nunca passa por cima de um build recém-instalado nem de um bundle local em teste.
#
# ON_ERROR:     o manifest configurado não respondeu (servidor fora do ar, JSON inválido)
# ON_NO_UPDATE: ele respondeu que não há novidade — tentado depois do ON_ERROR
OTA_FALLBACK_ON_ERROR=
OTA_FALLBACK_ON_NO_UPDATE=

# URL do servidor BFF (plugin opcional — deixe vazio para desativar)
BFF_URL=

# Provider de notificações: ntfy | firebase | none
NOTIFICATION_PROVIDER=none

# URL do servidor ntfy (obrigatório se NOTIFICATION_PROVIDER=ntfy)
NTFY_URL=
NTFY_TOPIC=

# Hosts opcionais para deep links via App Link http(s) (além do scheme fixo mymangareader://,
# sempre ativo). Lista separada por vírgula, sem espaços, cada item "host" ou "host:porta".
# Máximo de 5 (limite do lado Android) — itens além do 5º são ignorados com aviso.
# Deixe vazio se não usar. Exemplo: meuservidor.example.com,outroservidor.example.com:8080
DEEPLINK_HOSTS=
