{
  "name": "mymangareader",
  "version": "0.7.0-rc86",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.tsx --bundle-output ../android/app/src/main/assets/index.android.bundle --assets-dest ../android/app/src/main/res",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "validate:ota": "bash ../scripts/validate-ota.sh"
  },
  "dependencies": {
    "@react-native-community/netinfo": "^11",
    "@react-navigation/bottom-tabs": "6.6.1",
    "@react-navigation/native": "6.1.18",
    "@react-navigation/native-stack": "6.11.0",
    "@shopify/flash-list": "^1.7",
    "@shopify/react-native-skia": "^1.5.0",
    "lucide-react-native": "^1.31.0",
    "react": "18.3.1",
    "react-native": "0.75.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "3.35.0",
    "react-native-svg": "^15.15.5"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@babel/preset-env": "^7.25.0",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "14",
    "@react-native/babel-preset": "0.75.4",
    "@react-native/eslint-config": "0.75.4",
    "@react-native/metro-config": "0.75.4",
    "@react-native/typescript-config": "0.75.4",
    "@testing-library/react-native": "12.9.0",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.3.0",
    "@types/react-native": "^0.72.0",
    "@typescript-eslint/eslint-plugin": "^6",
    "@typescript-eslint/parser": "^6",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^29.16.0",
    "jest": "^29.7.0",
    "metro": "^0.80.0",
    "metro-config": "^0.80.0",
    "react-test-renderer": "18.3.1",
    "typescript": "~5.3"
  },
  "resolutions": {
    "minimatch": "^9.0.7",
    "fast-xml-parser": "^5.7.0",
    "image-size": "1.1.1"
  },
  "jest": {
    "preset": "react-native",
    "setupFiles": [
      "./node_modules/@shopify/react-native-skia/jestSetup.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@react-native|react-native|@shopify/react-native-skia)/)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    },
    "coverageProvider": "v8",
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.ts",
      "src/**/*.tsx"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/__tests__/",
      "\\.d\\.ts$",
      "/src/index\\.ts$"
    ],
    "coverageReporters": [
      "text",
      "lcov",
      "html"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 45,
        "lines": 45,
        "functions": 58,
        "branches": 85
      }
    }
  }
}
