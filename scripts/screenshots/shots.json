  "snippets": {
    "boot": [
      {
        "launch": true
      },
      {
        "wait_for": {
          "desc": "Biblioteca",
          "clickable": true
        }
      }
    ],
    "novel-from-library": [
      {
        "use": "library"
      },
      {
        "use": "ensure-list"
      },
      {
        "scroll_until": {
          "find": {
            "desc": ", Novel,",
            "clickable": true
          },
          "max": 60
        }
      },
      {
        "tap": {
          "desc": ", Novel,",
          "clickable": true
        }
      },
      {
        "wait_for": {
          "desc": "Voltar",
          "clickable": true
        }
      }
    ],
    "manga-reader": [
      {
        "use": "library"
      },
      {
        "use": "ensure-list"
      },
      {
        "scroll_until": {
          "find": {
            "desc_re": "^(?!.*, Novel,).*, (?:[1-9]\\d?|100)%(?:,|$)",
            "clickable": true,
            "class": "ViewGroup"
          },
          "max": 60
        }
      },
      {
        "tap": {
          "desc_re": "^(?!.*, Novel,).*, (?:[1-9]\\d?|100)%(?:,|$)",
          "clickable": true,
          "class": "ViewGroup"
        }
      },
      {
        "wait_for": {
          "desc": "Voltar",
          "clickable": true
        }
      },
      {
        "tap": {
          "clickable": true,
          "class": "ViewGroup",
          "min_size": [
            900,
            120
          ],
          "max_h": 140,
          "nth": 0
